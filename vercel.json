      "destination": "/memory-ledger",
      "permanent": true
    },
    {
      "source": "/xbrain-atlas",
      "destination": "/knowledge-atlas",
      "permanent": true
    },
    {
      "source": "/xbrain-atlas.html",
      "destination": "/knowledge-atlas",
      "permanent": true
    }
  ],
  "rewrites": [
