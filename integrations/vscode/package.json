{
  "name": "sovereignai",
  "displayName": "SovereignAI — Your AI Workspace",
  "description": "Use your SovereignAI workspace from the editor with streaming chat, personas, memory, and knowledge. Provider traffic follows your server configuration.",
  "version": "0.6.0",
  "publisher": "sovereignai",
  "icon": "icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/mlmrx/SovereignAI"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "ai",
    "chat",
    "ollama",
    "knowledge",
    "memory",
    "sovereign"
  ],
  "main": "./extension.js",
  "scripts": {
    "test": "node --test ../../test/vscode-integration.test.js"
  },
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "sovereignai.openChat",
        "title": "SovereignAI: Open Chat"
      },
      {
        "command": "sovereignai.askSelection",
        "title": "SovereignAI: Ask About Selection"
      },
      {
        "command": "sovereignai.saveSelectionToKnowledge",
        "title": "SovereignAI: Save Selection to Knowledge"
      },
      {
        "command": "sovereignai.remember",
        "title": "SovereignAI: Remember This (Long-term Memory)"
      },
      {
        "command": "sovereignai.setAuthToken",
        "title": "SovereignAI: Set Bearer Token"
      },
      {
        "command": "sovereignai.clearAuthToken",
        "title": "SovereignAI: Forget Bearer Token"
      },
      {
        "command": "sovereignai.testConnection",
        "title": "SovereignAI: Test Connection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sovereignai.askSelection",
          "when": "editorHasSelection",
          "group": "sovereignai@1"
        },
        {
          "command": "sovereignai.saveSelectionToKnowledge",
          "when": "editorHasSelection",
          "group": "sovereignai@2"
        }
      ]
    },
    "configuration": {
      "title": "SovereignAI",
      "properties": {
        "sovereignai.serverUrl": {
          "type": "string",
          "default": "http://127.0.0.1:4321",
          "scope": "machine",
          "markdownDescription": "Origin of your SovereignAI server, without a path (for example, `http://127.0.0.1:4321`). Run `sovereign start` to launch it."
        },
        "sovereignai.persona": {
          "type": "string",
          "default": "Engineer",
          "scope": "window",
          "markdownDescription": "Exact persona name to use for chat. Leave blank to use the server default."
        },
        "sovereignai.authToken": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Deprecated migration setting. A bearer token is required whenever the SovereignAI server has a token configured, including on localhost.",
          "deprecationMessage": "Use “SovereignAI: Set Bearer Token” so the token is stored in VS Code SecretStorage. Existing values are migrated automatically."
        }
      }
    }
  }
}
