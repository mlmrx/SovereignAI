{
  "manifest_version": 3,
  "name": "SovereignAI — Your Own AI",
  "version": "0.1.0",
  "description": "Chat with your self-hosted sovereign AI and save anything you read into its private knowledge base. Talks only to your own server.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SovereignAI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "browser_specific_settings": {
    "gecko": {
      "id": "sovereignai@sovereignai.local",
      "strict_min_version": "121.0"
    }
  }
}
