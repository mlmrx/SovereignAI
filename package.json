    "build:binary": "node scripts/build-sea.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mlmrx/SovereignAI.git"
  }
}
