{
  "name": "sovereignai",
  "version": "0.4.0",
  "description": "A private AI command center for user-owned models, memory, and knowledge. Zero runtime dependencies.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "sovereign": "bin/sovereign.js"
  },
  "scripts": {
    "start": "node --no-warnings bin/sovereign.js start",
