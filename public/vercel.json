{
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/land.html" },
    { "source": "/what-is-sovereign-ai", "destination": "/what-is-sovereign-ai.html" },
    { "source": "/sovereignty", "destination": "/sovereignty.html" },
    { "source": "/why", "destination": "/why.html" },
    { "source": "/faq", "destination": "/faq.html" },
    { "source": "/playground", "destination": "/playground.html" },
    { "source": "/xbrain", "destination": "/xbrain.html" },
    { "source": "/xbrain-ledger", "destination": "/xbrain-ledger.html" },
    { "source": "/xbrain-atlas", "destination": "/xbrain-atlas.html" },
    { "source": "/guide", "destination": "/guide.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
    }
  ]
}
